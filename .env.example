# Environment Variables for SecureID
# Copy this file to .env and fill in your values
# NEVER commit the real .env file to version control

# Server
PORT=3000
NODE_ENV=development

# JWT Secret - use a strong random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-strong-random-secret-at-least-64-chars

# Session Secret - use a strong random string in production
SESSION_SECRET=replace-with-a-different-strong-random-secret-at-least-32-chars

# Frontend URL (for CORS) - update to your Vercel URL in production
FRONTEND_URL=http://localhost:3000

# App Name (used in TOTP QR codes)
APP_NAME=SecureID
